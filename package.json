{
  "name": "@neophilism/scenesignal",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Endpoint-owned community spatial music sessions",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/server/accounts.d.ts",
      "import": "./dist/server/accounts.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "docs",
    "README.md",
    "dist/server",
    "server",
    "db/migrations"
  ],
  "scripts": {
    "core:prepare": "node scripts/prepare-core.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-build.mjs && tsc && vite build",
    "test": "npm run build && node --test dist/tests/*.test.js tests/*.test.mjs",
    "roadmap:check": "node scripts/check-roadmap.mjs",
    "check": "npm run core:check && npm run typecheck && npm run roadmap:check && npm run registry:check && npm test",
    "dev": "vite",
    "preview": "vite preview",
    "registry:check": "node scripts/validate-pr-registry.mjs && node --test registry/pr-contract.test.mjs",
    "test:postgres": "node --test tests/postgres-contribution.integration.mjs tests/account-service.integration.mjs",
    "test:native": "node scripts/test-native.mjs",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "db:migrate": "node --env-file-if-exists=.env dist/server/main.js --migrate",
    "core:check": "node scripts/check-core.mjs"
  },
  "dependencies": {
    "@neophilism/distributed-audio-engine": "file:.deps/audio-core.tgz",
    "better-auth": "1.7.18",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "6.4.6"
  }
}
