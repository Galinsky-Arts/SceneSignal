# Account-enabled Node host; the static draft build does not need these values.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Set a fresh random secret of at least 32 characters through secure environment settings.
BETTER_AUTH_SECRET=
PORT=3000
# Optional email password reset. Set both or neither; never commit the key.
RESEND_API_KEY=
SCENESIGNAL_MAIL_FROM=
